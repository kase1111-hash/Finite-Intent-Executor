# Contract addresses for a public-network deployment.
# Not needed locally: `npm run deploy` (repository root) writes
# src/contracts/deployedAddresses.js, which the dashboard loads automatically.
# Values set here take precedence over that file.
VITE_INTENT_MODULE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TRIGGER_MECHANISM_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EXECUTION_AGENT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_LEXICON_HOLDER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_SUNSET_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_IP_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Chain the contracts are deployed on (e.g. 11155111 for Sepolia). The
# dashboard warns when the connected wallet is on a different chain.
# VITE_CHAIN_ID=11155111

# Dev only: RPC URL of the local node used by "Use Local Dev Account"
# (default http://127.0.0.1:8545).
# VITE_RPC_URL=http://127.0.0.1:8545

# Security / monitoring integration (optional)
VITE_SECURITY_ENABLED=true
VITE_BOUNDARY_SIEM_URL=http://localhost:8080
VITE_BOUNDARY_SIEM_API_KEY=
VITE_BOUNDARY_DAEMON_HOST=localhost
VITE_BOUNDARY_DAEMON_PORT=9999
